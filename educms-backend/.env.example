# Application
PORT=5000
NODE_ENV=development
API_VERSION=v1

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=educms_db
DB_USER=educms_user
DB_PASSWORD=your_database_password

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# JWT Authentication
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Optional)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Frontend
FRONTEND_URL=http://localhost:5173

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=debug